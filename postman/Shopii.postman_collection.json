    {
      "name": "5. Manual COD demo — changes data",
      "item": [
        {
          "name": "Create demo address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": "{{baseUrl}}/buyers/addresses",
            "description": "Copy the returned address _id into addressId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Demo Reviewer\",\n  \"phone\": \"0000000000\",\n  \"street\": \"Dia chi demo\",\n  \"city\": \"Ho Chi Minh\",\n  \"state\": \"Demo\",\n  \"country\": \"Viet Nam\",\n  \"isDefault\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}"
              }
            ],
            "url": "{{baseUrl}}/buyers/orders",
            "description": "Set checkoutKey to a new UUID for each intended new order. Keep it unchanged for retry. A replay may correctly return 200 instead of 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"selectedAddressId\": \"{{addressId}}\",\n  \"selectedItems\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"couponCode\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.environment.set('orderId',pm.response.json().orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create COD payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
