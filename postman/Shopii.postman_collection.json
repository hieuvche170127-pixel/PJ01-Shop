{
  "info": {
    "name": "Shopii — SDN302 review",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import the sample environment. Fill local demo credentials only. Run read-only folders first. Mutation folder changes the selected demo DB; run requests manually in order. SMTP is not invoked by this collection except checkout notifications if configured. No password-reset/email requests are run automatically."
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerEmail}}\",\n  \"password\": \"{{buyerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('buyerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
